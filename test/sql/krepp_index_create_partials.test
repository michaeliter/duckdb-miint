# name: test/sql/krepp_index_create_partials.test
# description: several residues of one krepp index built into one directory
# group: [sql]

require miint

require-env KREPP_AVAILABLE

require-env MIINT_KREPP_TOY_REFS

# A large krepp index is not built in one pass. krepp partitions the k-mer space
# into m residues and `-r` selects which one to build, so the supported way to
# index hundreds of thousands of genomes is one residue per job, every job
# writing into the SAME directory with m, k, w, h and frac held fixed. krepp
# then loads every distinct suffix it finds there as a partial
# (ext/krepp/src/krepp.cpp:43-77) and compares only the hash function, reading
# `r` without comparing it (ext/krepp/src/index.cpp:73-86).
#
# frac := false is not incidental here. Under the default frac := true, `-r` is
# a cumulative THRESHOLD and not a selector: rqseq.cpp:133 keeps a k-mer when
# `rix_res <= r`, and index.cpp:146-148 registers the partial under every
# residue from 0 to r. Residues built that way NEST rather than partition - the
# largest covers the whole space by itself, the smaller ones are overwritten at
# load, and this file could not tell three partials from one. Partitioning the
# work across jobs needs --no-frac. The default is left alone because it is
# krepp's own default.
#
# Both halves of the round trip were previously blocked by miint:
# krepp_index_create refused any non-empty output_path, and place_krepp's layout
# check folded the residue into the index's identity, so three residues of one
# index read as three different indexes and were rejected.

statement ok
CREATE TABLE refs AS
SELECT regexp_extract(filepath, '([^/]+)\.fna$', 1) AS read_id, sequence1
FROM read_fastx('${MIINT_KREPP_TOY_REFS}/*.fna', include_filepath := true);

statement ok
CREATE TABLE backbone AS
SELECT node_index, parent_index, name, branch_length, node_index * 10 + 3 AS edge_id, is_tip
FROM read_newick('ext/krepp/test/tree_toy.nwk');

statement ok
CREATE TABLE toy_reads AS SELECT read_id, sequence1 FROM read_fastx('ext/krepp/test/query_toy.fq') LIMIT 40;

# Residue 1 creates the directory; 2 and 3 add to it. Anything but 'ok' here
# means adding a partial was refused. k := 25 puts h at 9 and keeps each partial
# small; none of the partial logic depends on k.
query I
SELECT status FROM krepp_index_create('refs', '__TEST_DIR__/idx_parts', tree_table := 'backbone', k := 25, m := 4, r := 1, frac := false);
----
ok

query I
SELECT status FROM krepp_index_create('refs', '__TEST_DIR__/idx_parts', tree_table := 'backbone', k := 25, m := 4, r := 2, frac := false);
----
ok

query I
SELECT status FROM krepp_index_create('refs', '__TEST_DIR__/idx_parts', tree_table := 'backbone', k := 25, m := 4, r := 3, frac := false);
----
ok

# One residue on its own, to compare against below.
query I
SELECT status FROM krepp_index_create('refs', '__TEST_DIR__/idx_one', tree_table := 'backbone', k := 25, m := 4, r := 1, frac := false);
----
ok

# Three complete partials on disk rather than one overwritten three times: six
# files per partial, with the metadata .txt sidecar falling outside the pattern.
query I
SELECT count(*) FROM glob('__TEST_DIR__/idx_parts/*') WHERE file LIKE '%-no_frac';
----
18

# place_krepp loads all three as ONE index. count(*) > 0 is the anti-vacuity
# guard: the middle filter is trivially true on an empty result. A directory
# place_krepp rejects raises rather than returning zero rows, so a regression
# there fails this query outright instead of passing it vacuously.
query III
SELECT count(*) > 0,
       count(*) FILTER (WHERE edge_num NOT IN (SELECT edge_id FROM backbone)) = 0,
       count(DISTINCT edge_num) > 1
FROM place_krepp(query_table='toy_reads', index_path='__TEST_DIR__/idx_parts');
----
true	true	true

# ...and more than one of them CONTRIBUTES. The query above passes just as well
# when only a single partial is usable - measured on this fixture, r=1 alone
# places the same 37 distinct fragments as all three together, so neither the
# fragment count nor the row count separates the two. What does separate them is
# placements the three-partial index finds that the one-partial index cannot:
# measured 3 of them here. Were place_krepp to fall back to one partial, or were
# residues 2 and 3 to stop being loaded, this drops to 0.
query I
SELECT count(*) > 0 FROM (
    SELECT fragment, edge_num FROM place_krepp(query_table='toy_reads', index_path='__TEST_DIR__/idx_parts')
    EXCEPT
    SELECT fragment, edge_num FROM place_krepp(query_table='toy_reads', index_path='__TEST_DIR__/idx_one')
);
----
true

# Writing the same residue twice would write over the partial that is there.
statement error
SELECT status FROM krepp_index_create('refs', '__TEST_DIR__/idx_parts', tree_table := 'backbone', k := 25, m := 4, r := 2, frac := false);
----
already holds the partial this build would write ('-m4r2-no_frac')

# A different m is a different hash function. The expected text reaches past the
# shared phrase into 'vs this build's', which only the PRE-build refusal emits:
# pinning the short phrase alone also matched the POST-build validator, which
# fires only after krepp has already written a second index into the directory,
# so deleting the check under test still passed.
statement error
SELECT status FROM krepp_index_create('refs', '__TEST_DIR__/idx_parts', tree_table := 'backbone', k := 25, m := 8, r := 1, frac := false);
----
different hash configuration ('m4-no_frac' vs this build's 'm8-no_frac')

# k is in no filename but decides the LSH positions just as much, so it is
# compared against the metadata of a partial already there.
statement error
SELECT status FROM krepp_index_create('refs', '__TEST_DIR__/idx_parts', tree_table := 'backbone', k := 29, m := 4, r := 4, frac := false);
----
holds partials built with k := 25, but this build uses k := 29

# w and h are the two the check used to let through. They were compared only
# when the CALLER pinned them, on the reasoning that an unset w or h is derived
# from k - true of THIS build, but silent about the partial already on disk,
# which may have been built with an explicit one. So an explicit h followed by
# an unset h was accepted: same k, different LSH, and krepp only says so at
# query time, after the build. The comparison is against the EFFECTIVE values
# now, so the order no longer matters.
query I
SELECT status FROM krepp_index_create('refs', '__TEST_DIR__/idx_hgap', tree_table := 'backbone', k := 25, m := 4, r := 1, frac := false, h := 10);
----
ok

statement error
SELECT status FROM krepp_index_create('refs', '__TEST_DIR__/idx_hgap', tree_table := 'backbone', k := 25, m := 4, r := 2, frac := false);
----
holds partials built with h := 10, but this build uses h := 9

# w is the worse of the two: LSHF::check_compatible (ext/krepp/src/lshf.cpp:161)
# compares m, h, k and the positions but never w, and load_partial_index reads w
# into a local it discards (index.cpp:59-63). A w mismatch is therefore caught
# nowhere downstream - it just leaves one index holding two different sets of
# minimizers, with no error at any point.
query I
SELECT status FROM krepp_index_create('refs', '__TEST_DIR__/idx_wgap', tree_table := 'backbone', k := 25, m := 4, r := 1, frac := false, w := 40);
----
ok

statement error
SELECT status FROM krepp_index_create('refs', '__TEST_DIR__/idx_wgap', tree_table := 'backbone', k := 25, m := 4, r := 2, frac := false);
----
holds partials built with w := 40, but this build uses w := 31
