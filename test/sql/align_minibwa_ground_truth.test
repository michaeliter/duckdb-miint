m84137_260130_125423_s3/18156364/ccs	0	NC_000913.3	4177174	4178821	60	1647M	*	0	0	3284	NULL	NULL	NULL	0	0	0	1	UU	NULL
m84137_260130_125423_s3/219548324/ccs	0	NC_000913.3	1012833	1015181	60	14S2348M	*	0	0	4696	NULL	NULL	NULL	0	0	0	0	UU	NULL
m84137_260130_125423_s3/234685748/ccs	16	NC_000913.3	2938461	2940752	60	2291M9S	*	0	0	4582	NULL	NULL	NULL	0	0	0	0	UU	NULL
m84137_260130_125423_s3/63641322/ccs	16	NC_000913.3	3445575	3448277	60	2702M	*	0	0	5394	NULL	NULL	NULL	0	0	0	1	UU	NULL
